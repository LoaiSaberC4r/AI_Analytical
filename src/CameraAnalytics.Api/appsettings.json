{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=AI_Analytics;User Id=sa;Password=Atlo@2026;MultipleActiveResultSets=True;TrustServerCertificate=True;"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false
  },
  "Cors": {
    "Enabled": true,
    "AllowedOrigins": [
      "http://localhost:4200"
    ],
    "AllowCredentials": true
  },
  "Mqtt": {
    "Enabled": true,
    "Host": "192.168.1.8",
    "Port": 1883,
    "ProtocolVersion": "3.1.1",
    "TopicFilter": "cameras/+/analytics",
    "ClientId": "camera-analytics-api",
    "Qos": 1,
    "PersistentSession": true,
    "SessionExpirySeconds": 604800,
    "UseTls": false,
    "KeepAliveSeconds": 30,
    "ConnectTimeoutSeconds": 10,
    "ReconnectDelaySeconds": 5,
    "MaxPayloadBytes": 1048576
  },
  "SignalR": {
    "Enabled": true,
    "HubPath": "/hubs/analytics",
    "KeepAliveIntervalSeconds": 15,
    "ClientTimeoutSeconds": 30,
    "Transport": "All"
  },
  "Analytics": {
    "ExpectedMessageIntervalSeconds": 1,
    "StaleAfterSeconds": 5,
    "NoRecentDataAfterSeconds": 15,
    "TrackMissingGraceSeconds": 5,
    "MaximumSnapshotGapSeconds": 5,
    "DefaultWarningThresholdPercent": 80,
    "DefaultCriticalThresholdPercent": 100,
    "DefaultAggregationInterval": "hour",
    "MaximumReportRangeDays": 90,
    "MaximumMinuteReportRangeDays": 7,
    "MinimumCoveragePercentForPeakRanking": 80,
    "ClockSkewToleranceSeconds": 10
  },
  "Aggregation": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "BatchSize": 50
  },
  "Retention": {
    "Enabled": false,
    "RawSnapshotsDays": 7,
    "ProcessedMessagesDays": 30,
    "HourlyAggregatesDays": 365
  },
  "OpenApi": {
    "Enabled": true,
    "EnableSwaggerUi": true
  },
  "HealthChecks": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}