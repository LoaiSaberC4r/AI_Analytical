{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false
  },
  "Security": {
    "Authority": "",
    "Audience": ""
  },
  "Cors": {
    "Enabled": true,
    "AllowedOrigins": [
      "http://localhost:4200"
    ],
    "AllowCredentials": true
  },
  "Mqtt": {
    "Enabled": true,
    "Host": "192.168.1.8",
    "Port": 1883,
    "ProtocolVersion": "3.1.1",
    "TopicFilter": "cameras/+/analytics",
    "ClientId": "camera-analytics-api",
    "Qos": 1,
    "PersistentSession": true,
    "SessionExpirySeconds": 604800,
    "UseTls": false,
    "KeepAliveSeconds": 30,
    "ConnectTimeoutSeconds": 10,
    "ReconnectDelaySeconds": 5,
    "MaxPayloadBytes": 1048576,
    "MaxSourceNameLength": 512,
    "MaxZonesPerMessage": 256,
    "MaxActiveVisitorsPerZone": 4096
  },
  "SignalR": {
    "Enabled": true,
    "HubPath": "/hubs/analytics",
    "KeepAliveIntervalSeconds": 15,
    "ClientTimeoutSeconds": 30,
    "Transport": "All"
  },
  "Analytics": {
    "ExpectedMessageIntervalSeconds": 1,
    "StaleAfterSeconds": 5,
    "NoRecentDataAfterSeconds": 15,
    "TrackMissingGraceSeconds": 5,
    "MaximumSnapshotGapSeconds": 5,
    "DefaultWarningThresholdPercent": 80,
    "DefaultCriticalThresholdPercent": 100,
    "DefaultAggregationInterval": "hour",
    "MaximumReportRangeDays": 90,
    "MaximumMinuteReportRangeDays": 7,
    "MinimumCoveragePercentForPeakRanking": 80,
    "ClockSkewToleranceSeconds": 10
  },
  "Aggregation": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "BatchSize": 50
  },
  "Visualization": {
    "MaxSeries": 30,
    "MaxPointsPerSeries": 1500,
    "DefaultRefreshSeconds": 5,
    "MinimumRateCoveragePercent": 80
  },
  "MinuteAggregation": {
    "Enabled": true,
    "IntervalSeconds": 15,
    "BatchSize": 100,
    "FinalizationDelaySeconds": 5,
    "BackfillDays": 7
  },
  "Congestion": {
    "MinObservedDurationSeconds": 30,
    "RecoveryObservedSeconds": 15,
    "MaxObservationGapSeconds": 5
  },
  "FloorPlans": {
    "MaxPolygonVertices": 100,
    "MaxLayoutsPerFloor": 100
  },
  "Alerts": {
    "Enabled": true,
    "EvaluateEverySeconds": 5,
    "MinimumCoveragePercent": 80,
    "DefaultCooldownSeconds": 300,
    "MaxRules": 500
  },
  "Forecast": {
    "Enabled": true,
    "MinHistoryDays": 28,
    "PreferredLookbackDays": 56,
    "MinComparableSlots": 4,
    "MinimumCoveragePercent": 80,
    "HorizonHours": 24
  },
  "DwellAnalytics": {
    "HistogramUpperBoundsSeconds": [30, 60, 180, 300, 600],
    "DefaultLongStaySeconds": 300
  },
  "Retention": {
    "Enabled": false,
    "RawSnapshotsDays": 7,
    "ProcessedMessagesDays": 30,
    "HourlyAggregatesDays": 365,
    "MinuteAggregatesDays": 90,
    "AlertHistoryDays": 365
  },
  "OpenApi": {
    "Enabled": true,
    "EnableSwaggerUi": true
  },
  "HealthChecks": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
